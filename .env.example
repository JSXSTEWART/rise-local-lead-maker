# Rise Local Lead Maker - Environment Configuration
# Copy this file to .env and fill in the values

# ===========================================
# REQUIRED - Server Configuration
# ===========================================
NODE_ENV=production
PORT=3001

# ===========================================
# REQUIRED - Database (MySQL)
# ===========================================
DB_HOST=localhost
DB_USER=rise
DB_PASSWORD=your_secure_password_here
DB_NAME=rise_leads

# For Docker Compose only
MYSQL_ROOT_PASSWORD=your_root_password_here

# ===========================================
# OPTIONAL - AI Enrichment Providers
# ===========================================
# Anthropic Claude - AI-powered lead insights
ANTHROPIC_API_KEY=

# Google Gemini - Alternative AI provider
GEMINI_API_KEY=

# ===========================================
# OPTIONAL - Data Enrichment
# ===========================================
# Clay.io - Person and company data enrichment
CLAY_API_KEY=
CLAY_TABLE_ID=

# ===========================================
# OPTIONAL - Lead Scraping
# ===========================================
# Google Places API - Local business discovery
GOOGLE_PLACES_API_KEY=

# ===========================================
# OPTIONAL - Google Sheets Sync
# ===========================================
# Service account credentials for Sheets API
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEETS_ID=

# ===========================================
# OPTIONAL - Supabase (PostgreSQL alternative)
# ===========================================
# Only needed if migrating from MySQL to PostgreSQL
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
