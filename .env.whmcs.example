# WHMCS LLM Container Provisioning - Example Configuration
# Copy this to .env and customize for your deployment

# ==========================================
# Portainer Configuration
# ==========================================
PORTAINER_URL=https://portainer.yourdomain.com
PORTAINER_USERNAME=admin
PORTAINER_PASSWORD=change-this-secure-password

# ==========================================
# HuggingFace Authentication
# ==========================================
# Required for downloading models like Llama 3
# Get token from: https://huggingface.co/settings/tokens
HF_TOKEN=hf_your_token_here

# ==========================================
# Traefik API Gateway
# ==========================================
# Email for Let's Encrypt SSL certificates
ACME_EMAIL=admin@yourdomain.com

# Dashboard domain (optional)
TRAEFIK_DASHBOARD_DOMAIN=traefik.yourdomain.com

# Basic auth for dashboard (generate with: htpasswd -nb admin password)
TRAEFIK_BASIC_AUTH=admin:$$apr1$$...

# ==========================================
# Monitoring & Metrics
# ==========================================
PROMETHEUS_URL=http://localhost:9090
GRAFANA_ADMIN_PASSWORD=change-this-password

# ==========================================
# Zapier Integration
# ==========================================
# Webhook signature secret for security
# Generate with: openssl rand -hex 32
ZAPIER_WEBHOOK_SECRET=your-webhook-secret-here

# ==========================================
# Rise API Integration
# ==========================================
RISE_API_URL=http://localhost:3001

# Existing Rise API keys (from main .env)
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GOOGLE_PLACES_API_KEY=

# ==========================================
# Database (if separate from main Rise DB)
# ==========================================
# DB_HOST=localhost
# DB_USER=whmcs_llm
# DB_PASSWORD=secure-password
# DB_NAME=whmcs_llm_metrics

# ==========================================
# LLM Container Defaults
# ==========================================
DEFAULT_GPU_MEMORY_UTIL=0.9
DEFAULT_MAX_MODEL_LEN=8192
DEFAULT_RATE_LIMIT=100

# ==========================================
# Billing Configuration
# ==========================================
# Pricing per unit (USD)
GPU_HOUR_RATE=2.00
TOKEN_RATE=0.0001
REQUEST_RATE=0.001

# ==========================================
# cPanel/LiteSpeed Integration (optional)
# ==========================================
# CPANEL_API_TOKEN=
# CPANEL_USERNAME=
# CPANEL_DOMAIN=acme.zonedock.com
