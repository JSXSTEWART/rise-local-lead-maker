# Production Environment Configuration for Rise Local Lead Maker
# Copy this to rise-local-lead-creation/api/.env and fill in actual values
# Location: /home/apex2600/rise-local-lead-maker/rise-local-lead-creation/api/.env

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=apex2600_riselocal
DB_USER=apex2600_riselocal
DB_PASSWORD=Riseleads2025!Secure

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================
PORT=3001
NODE_ENV=production
LOG_LEVEL=info

# ============================================================================
# GOOGLE SHEETS INTEGRATION
# ============================================================================
# Spreadsheet ID (found in URL: https://docs.google.com/spreadsheets/d/{ID})
GOOGLE_SHEETS_ID=1CUl-ZdHFK6llBRkTp4JMX_639ro0shciPpmlXWrVx7s

# Service Account Email (from service-account.json)
GOOGLE_SERVICE_ACCOUNT_EMAIL=210870422605-compute@developer.gserviceaccount.com

# Service Account Private Key ID (from service-account.json)
GOOGLE_PRIVATE_KEY_ID=22bcce741fd6942cb5b577d9edeb5718a86615bd

# Service Account Private Key (FULL KEY - replace [KEY_CONTENT])
# IMPORTANT: This is a multiline key - keep the \n between lines
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
MIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...
[PASTE_FULL_PRIVATE_KEY_HERE]
...ENDING_KEY_CONTENT
-----END PRIVATE KEY-----"

# ============================================================================
# ENRICHMENT APIs
# ============================================================================
# Clay API (Company and Person Enrichment)
# Get key from: https://app.clayhq.com/settings/api
CLAY_API_KEY=05301108e328ab6bf915

# Anthropic Claude API
# Get key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-YOUR_KEY_HERE

# Google Gemini API
# Get key from: https://aistudio.google.com/app/apikey
GOOGLE_GEMINI_API_KEY=AIzaSyB3PY1YOUR_KEY_HERE

# Google Places API
# Get key from: https://console.cloud.google.com/
GOOGLE_PLACES_API_KEY=AIzaSyB3PY1YOUR_KEY_HERE

# ============================================================================
# SHEETS EXPORT SCHEDULER
# ============================================================================
# Enable automatic export to Google Sheets
ENABLE_SHEETS_EXPORT_SCHEDULER=true

# Interval in minutes (minimum 5 recommended)
SHEETS_EXPORT_INTERVAL_MINUTES=5

# Export only leads with this status (new, enriched, qualified, etc)
SHEETS_EXPORT_STATUS=enriched

# Batch size per export (limit for API quota)
SHEETS_EXPORT_BATCH_SIZE=50

# ============================================================================
# OPTIONAL: SUPABASE (if using as backup database)
# ============================================================================
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ============================================================================
# OPTIONAL: MONITORING & LOGGING
# ============================================================================
# SENTRY_DSN=https://YOUR_KEY@sentry.io/YOUR_PROJECT
# DATADOG_API_KEY=YOUR_KEY

# ============================================================================
# CORS & SECURITY
# ============================================================================
# Allowed origins for CORS (comma-separated)
CORS_ORIGIN=https://acme.zonedock.com,https://www.acme.zonedock.com

# Rate limit (requests per minute)
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100

# ============================================================================
# DEPLOYMENT INFO
# ============================================================================
# Deployment target
DEPLOYMENT_ENV=cpanel
DEPLOYMENT_HOST=acme.zonedock.com
DEPLOYMENT_USER=apex2600

# Application identifier for logging
APP_ID=rise-local-lead-maker
APP_VERSION=1.0.0
